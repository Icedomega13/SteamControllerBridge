<Page
    x:Class="SteamControllerBridge.GameBarWidget.WidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BridgeBackBrush}">

    <Grid Padding="18" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="58" />
            <RowDefinition Height="92" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="86" />
            </Grid.ColumnDefinitions>

            <Ellipse
                x:Name="StatusDot"
                Width="12"
                Height="12"
                VerticalAlignment="Top"
                Fill="#8497ac"
                Margin="0,9,0,0" />

            <StackPanel Grid.Column="1" Spacing="0">
                <TextBlock
                    x:Name="StatusText"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="Checking" />
                <TextBlock
                    x:Name="MessageText"
                    FontSize="12"
                    Foreground="{StaticResource BridgeSoftBrush}"
                    Text="Waiting for bridge"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Button
                x:Name="ToggleButton"
                Grid.Column="2"
                Height="52"
                Width="72"
                Padding="0"
                Background="{StaticResource BridgePanelBrush}"
                BorderBrush="#506f97be"
                Click="ToggleButton_Click">
                <Image
                    x:Name="ToggleImage"
                    Width="64"
                    Height="46"
                    Stretch="Uniform" />
            </Button>
        </Grid>

        <Border
            Grid.Row="1"
            Padding="12,8"
            Background="{StaticResource BridgePanelBrush}"
            BorderBrush="#506f97be"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="46" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="White" Text="Rumble" />
                <Grid
                    Grid.Column="1"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="34" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="RumbleDownButton"
                        Width="34"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="#1c3550"
                        BorderBrush="#506f97be"
                        Click="RumbleDownButton_Click"
                        Content="-" />

                    <ProgressBar
                        x:Name="RumbleBar"
                        Grid.Column="1"
                        Height="8"
                        Maximum="100"
                        Minimum="0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource BridgeAccentBrush}"
                        Background="#263a52"
                        Value="50" />

                    <Button
                        x:Name="RumbleUpButton"
                        Grid.Column="2"
                        Width="34"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Background="#1c3550"
                        BorderBrush="#506f97be"
                        Click="RumbleUpButton_Click"
                        Content="+" />
                </Grid>
                <TextBlock
                    x:Name="RumbleValueText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource BridgeAccentBrush}"
                    Text="50%" />
            </Grid>
        </Border>

        <Border
            Grid.Row="2"
            Padding="10"
            Background="{StaticResource BridgePanelBrush}"
            BorderBrush="#506f97be"
            BorderThickness="1"
            CornerRadius="10">
            <Grid ColumnSpacing="8" RowSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="42" />
                </Grid.RowDefinitions>

                <TextBlock Foreground="{StaticResource BridgeSoftBrush}" Text="L4" />
                <TextBlock Grid.Column="1" Foreground="{StaticResource BridgeSoftBrush}" Text="L5" />
                <TextBlock Grid.Column="2" Foreground="{StaticResource BridgeSoftBrush}" Text="R4" />
                <TextBlock Grid.Column="3" Foreground="{StaticResource BridgeSoftBrush}" Text="R5" />

                <ComboBox x:Name="L4Combo" Grid.Row="1" SelectionChanged="PaddleCombo_SelectionChanged" />
                <ComboBox x:Name="L5Combo" Grid.Row="1" Grid.Column="1" SelectionChanged="PaddleCombo_SelectionChanged" />
                <ComboBox x:Name="R4Combo" Grid.Row="1" Grid.Column="2" SelectionChanged="PaddleCombo_SelectionChanged" />
                <ComboBox x:Name="R5Combo" Grid.Row="1" Grid.Column="3" SelectionChanged="PaddleCombo_SelectionChanged" />
            </Grid>
        </Border>

        <TextBlock
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Foreground="{StaticResource BridgeSoftBrush}"
            FontSize="12"
            Text="Run Steam Controller Bridge first." />
    </Grid>
</Page>
